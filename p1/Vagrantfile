# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  ip_address = "192.168.56.110"

  config.vm.box = "debian/bookworm64"
  config.vm.network "private_network", ip: ip_address
  config.vm.hostname = "bbrassarS"

  config.vm.provider "virtualbox" do |vb|
    vb.name = "bbrassarS"
    vb.cpus = 1
    vb.memory = 1024
  end
end
