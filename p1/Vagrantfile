Vagrant.configure("2") do |config|
  config.vm.box = "debian/bookworm64"
  config.vm.network "private_network", ip: "192.168.56.110"
  config.vm.hostname = "bbrassarS"

  config.vm.provider "virtualbox" do |vb|
    vb.name = "bbrassarS"
    vb.cpus = 1
    vb.memory = 1024
  end
end
