# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  # https://github.com/k3s-io/k3s/releases/tag/v1.32.3+k3s1
  k3s_install_url = "https://raw.githubusercontent.com/k3s-io/k3s/079ffa8d99fb859cb8c001455e47efa65535d832/install.sh"
  k3s_install_sha256 = "d75e014f2d2ab5d30a318efa5c326f3b0b7596f194afcff90fa7a7a91166d5f7"

  config.vm.define "bbrassarS" do |server|
    ip_address = "192.168.56.110"

    server.vm.box = "debian/bookworm64"
    server.vm.network "private_network", ip: ip_address
    server.vm.hostname = "bbrassarS"

    server.vm.provider "virtualbox" do |vb|
      vb.name = "bbrassarS"
      vb.cpus = 1
      vb.memory = 1024
    end

    server.vm.provision "shell", inline: <<-SHELL
      printf -- 'alias k=kubectl\n' | tee /etc/profile.d/kubectl.sh
    SHELL

    server.vm.provision "shell",
      path: k3s_install_url,
      args: [
        "--cluster-init",
        "--write-kubeconfig-mode=644",
        "--node-ip", ip_address,
        "--bind-address", ip_address,
      ],
      env: {
        "INSTALL_K3S_EXEC": "server",
      },
      sha256: k3s_install_sha256

    server.vm.provision "shell", inline: <<-SHELL
      cp -v /var/lib/rancher/k3s/server/token /vagrant/token
      cp -v /etc/rancher/k3s/k3s.yaml /vagrant/k3s.yaml
    SHELL
  end

  config.vm.define "bbrassarSW" do |worker|
    ip_address = "192.168.56.111"

    worker.vm.box = "debian/bookworm64"
    worker.vm.network "private_network", ip: ip_address
    worker.vm.hostname = "bbrassarSW"

    worker.vm.provider "virtualbox" do |vb|
      vb.name = "bbrassarSW"
      vb.cpus = 1
      vb.memory = 1024
    end

    worker.vm.provision "shell", inline: <<-SHELL
      printf -- 'alias k=kubectl\n' | tee /etc/profile.d/kubectl.sh
    SHELL

    worker.vm.provision "shell",
      path: k3s_install_url,
      args: [
        "--node-ip", ip_address,
        "--server", "https://192.168.56.110:6443",
      ],
      env: {
        "INSTALL_K3S_EXEC": "agent",
        "K3S_TOKEN_FILE": "/vagrant/token",
        "KUBECONFIG": "/vagrant/k3s.yaml",
      },
      sha256: k3s_install_sha256
  end
end
